@model Anime.Models.CharacterEntry
@{ ViewData["Title"] = Model.Character.Name; }

<a href="/" style="display: inline-block; margin-bottom: 1.5rem; color: #1a1a2e; font-weight: bold;">← Tornar</a>

<div style="background: white; border-radius: 8px; padding: 2rem; max-width: 400px; box-shadow: 0 2px 6px rgba(0,0,0,0.1);">
    <img src="@Model.Character.Images.Jpg.Image_url" alt="@Model.Character.Name" style="width: 200px; display: block; margin: 0 auto 1.5rem;" />
    <h1 style="margin-bottom: 1rem;">@Model.Character.Name</h1>
    <p><strong>Rol:</strong> @Model.Role</p>
    <p><strong>Favorits:</strong> @Model.Favorites</p>
</div>